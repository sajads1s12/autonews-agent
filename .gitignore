# =============================================================================
#  AutoNews Agent — .gitignore
#
#  الهدف: **لا يخرج سرّ ولا بيانات خاصة إلى المستودع العام أبداً.**
#
#  الفلسفة المتّبعة (طبقتان):
#    ١) المستودع العام (هذا)  →  الكود فقط: src/ · tests/ · .github/ · config/ القوالب
#    ٢) المستودع الخاص        →  state/ · logs/ · config/ الفعلي (يُزامَن بـ state_sync)
#
#  ملاحظة: config/ **ليس** متجاهلاً — يحتاج المستودع العام قالباً يعمل به
#  أول تشغيل. القيم الخاصة (المعرّفات) تُكتب من البوت وتُزامَن مع الخاص.
# =============================================================================

# ---------------------------------------------------------------------------
#  🔐 الأسرار — الخطّ الأحمر
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets.json
credentials.json
service-account*.json
*token*.json
!*token*_example.json
.netrc
.git-credentials
*.kdbx

# ---------------------------------------------------------------------------
#  🔗 مزامنة المستودع الخاص (state_sync) — لا تُرفع أبداً
# ---------------------------------------------------------------------------
.state-repo/
.state-archive/
.state-git/
.autonews_extract/
skip-worktree.txt

# ---------------------------------------------------------------------------
#  🗂 الحالة والتقارير — تنتمي للمستودع الخاص
#     (تُستثنى ملفات .gitkeep كي يبقى المجلد موجوداً في النسخة العامة)
# ---------------------------------------------------------------------------
state/*
!state/.gitkeep
state/**/*.json
state/**/*.jsonl
state/**/*.bak

logs/*
!logs/.gitkeep
logs/**/*.html
logs/**/*.log
logs/**/*.json
logs/**/*.md

# ---------------------------------------------------------------------------
#  📦 ملفات مضغوطة ونسخ احتياطية — خطر تسريب
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz
*.bz2
backup*/
*_backup/
*.bak
*.orig
*.rej
*.old
*.save

# ---------------------------------------------------------------------------
#  🐍 Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# بيئات افتراضية
.venv/
venv/
ENV/
env/
.python-version

# أدوات الفحص والتغطية
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# ---------------------------------------------------------------------------
#  🧰 محرّرات وأنظمة
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/settings.example.json
*.sublime-*

# ---------------------------------------------------------------------------
#  🐳 Docker / سجلات محلية
# ---------------------------------------------------------------------------
docker-compose.override.yml
*.log
logs_*/
!logs/.gitkeep

# ---------------------------------------------------------------------------
#  ⚠️ استثناءات صريحة — ممنوع تجاهلها
# ---------------------------------------------------------------------------
!.github/**
!requirements.txt
!.env.example
!state/.gitkeep
!logs/.gitkeep
!docs/*.md

# Private local data
/config/channels.yml
/config/settings.yml
/logs/
/state/
.env
