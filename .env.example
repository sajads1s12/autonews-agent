# =============================================================================
#  تُنسخ إلى ملف .env محلياً (ولا تُرفع للمستودع أبداً)
#  cp .env.example .env
# =============================================================================

# ---------------------------- مفاتيح Gemini ---------------------------------
# الطريقة (أ): مفتاح واحد أو أكثر مفصولة بفواصل
GEMINI_API_KEYS=key_one_here,key_two_here,key_three_here,key_four_here,key_five_here

# الطريقة (ب): مفاتيح مرقّمة (النظام يقرأ حتى 10)
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# اختياري: تجاوز قائمة النماذج (الأول أولاً، والباقي خطة بديلة)
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-pro

# ------------------------------- تيليجرام -----------------------------------
# أنشئ بوتاً من @BotFather ثم أضفه مشرفاً في القناة
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=@my_channel
TELEGRAM_TECH_CHAT_ID=-1001234567890

# -------------------------------- فيسبوك ------------------------------------
# page_id من: إعدادات الصفحة → About → Page ID
FACEBOOK_PAGE_ID=1234567890123456
# الأفضل: توكن صفحة طويل الأمد (لا ينتهي)
FACEBOOK_PAGE_TOKEN=
# بديل: توكن مستخدم بصلاحيات pages_show_list,pages_manage_posts
FACEBOOK_USER_TOKEN=

# ----------------------------------- X ---------------------------------------
# من: developer.x.com → App → Keys and tokens (صلاحية Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# X_BEARER_TOKEN=

# ------------------------ النشر الفوري (Flash Lane) ---------------------------
# قناة «وكالة» خاصة تنشر فيها من جوالك فيخرج فوراً على قنواتك الرسمية
# TELEGRAM_SCOPED_CHAT_ID=-1001234567890

# --------------------- التنبيهات والمراجعة البشرية ---------------------------
# دردشة إدارية خاصة (غير قنوات النشر) لرسائل التنبيه والمسوّدات
# ALERT_BOT_TOKEN=
# ALERT_CHAT_ID=
# REQUIRE_REVIEW=true       # كل المنشورات تمرّ بمراجعتك أولاً

# --------------------------- تحكّم التشغيل ----------------------------------
# DRY_RUN=true            # معاينة فقط بلا نشر
# MAX_ITEMS_PER_RUN=12
# LOG_LEVEL=INFO
# ENABLED_CHANNELS=tg_main   # قصر التشغيل على قناة معيّنة (مفصولة بفاصلة)
