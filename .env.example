# =============================================================================
#  AutoNews Agent — قالب متغيّرات البيئة
#
#  ⚠️ هذا الملف **قالب فقط** — لا يحتوي أي قيمة حقيقية. يُنسخ محلياً:
#        cp .env.example .env        (و .env متجاهَل في .gitignore)
#
#  على GitHub: لا تستخدم هذا الملف إطلاقاً — ضع القيم في
#  Settings → Secrets and variables → Actions → New repository secret
#  (الدليل الكامل: docs/أسرار-GitHub.md)
# =============================================================================

# =============================================================================
#  ١) إلزامي — بلا هذه الثلاثة لا يعمل شيء
# =============================================================================

# --- مفاتيح Gemini (٥ على الأقل للأداء الأمثل؛ النظام يبدّل تلقائياً عند تعطّل أي مفتاح) ---
# الطريقة (أ): مفاتيح مفصولة بفواصل — اسم السرّ في GitHub: GEMINI_API_KEYS
GEMINI_API_KEYS=
# الطريقة (ب): مفاتيح مرقّمة — أسماء الأسرار: GEMINI_API_KEY_1 … GEMINI_API_KEY_5
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# --- بوت تيليجرام (من @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- معرّفك الشخصي (للإشعارات ولوحة التحكّم) — من @userinfobot ---
TELEGRAM_ADMIN_CHAT_ID=

# =============================================================================
#  ٢) مزامنة المستودع الخاص (تحافظ على ذاكرة البوت بين التشغيلات)
# =============================================================================
# مستودع الحالة الخاص: owner/autonews-state
STATE_REPO=
# PAT كلاسيكي بصلاحية repo على مستودع الحالة فقط (ليس على كل حسابك)
STATE_REPO_TOKEN=
STATE_REPO_BRANCH=main

# =============================================================================
#  ٣) تيليجرام — معرّفات القنوات
# =============================================================================
# يمكن تركها فارغة: البوت يحفظ المعرّفات في state/channels_setup.json
# عند ربط القنوات من اللوحة (الطريقة الموصى بها على الهاتف).
# TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# TELEGRAM_ANIME_CHAT_ID=
# TELEGRAM_SPORTS_CHAT_ID=
# TELEGRAM_TECH_CHAT_ID=
# TELEGRAM_ECON_CHAT_ID=
# TELEGRAM_GAMES_CHAT_ID=
# TELEGRAM_LOCAL_CHAT_ID=

# حماية البوت: من يُسمح له بالتحكّم (معرّفات مفصولة بفواصل — فارغ = الجميع مسموح)
SETUP_ALLOWED_USERS=

# =============================================================================
#  ٤) فيسبوك (اختياري — القناة معطّلة افتراضياً)
# =============================================================================
# معرّف الصفحة رقم عام (لا يوجد ضرر من ظهوره)، لكن نتركه في الأسرار.
FACEBOOK_PAGE_ID=
# توكن صفحة دائم (لا ينتهي) — انظر docs/فيسبوك-الربط.md
FACEBOOK_PAGE_TOKEN=

# =============================================================================
#  ٥) منصّة X (اختياري — القناة معطّلة افتراضياً)
# =============================================================================
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# =============================================================================
#  ٦) التنبيهات
# =============================================================================
# ALERT_BOT_TOKEN=
# ALERT_CHAT_ID=

# =============================================================================
#  ٧) تحكّم التشغيل (قيم افتراضية آمنة — لا تغيّرها في GitHub Secrets)
# =============================================================================
# DRY_RUN=true              # معاينة فقط بلا نشر
# MAX_ITEMS_PER_RUN=12
# LOG_LEVEL=INFO
# ENABLED_CHANNELS=         # قصر التشغيل على قنوات معيّنة
# STATE_FILE=state/state.json
# TZ_OFFSET=3               # بغداد

# =============================================================================
#  ✅ قائمة تحقّق سريعة
#    ١) املأ ٣ أسرار إلزامية (Gemini · bot token · admin id)
#    ٢) املأ STATE_REPO + STATE_REPO_TOKEN (يحفظ الذاكرة)
#    ٣) لا تضع أي قيمة هنا أو في أي ملف داخل المستودع
#    ٤) شغّل: bash scripts/check_secrets.sh
# =============================================================================
